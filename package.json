{
  "name": "boilerlift",
  "description": "Version, test and deploy your n8n workflows to every environment and client, from one Git repo.",
  "author": "laurentvandelle",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lift": "dist/bin.js",
    "boilerlift": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run build && npm run start:prod --",
    "start:prod": "cd debug && node main.ts",
    "debug:setup": "node debug/setup.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('templates/project','dist/templates/project',{recursive:true})\"",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src --fix",
    "lint:check": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint:check && npm run typecheck && npm test",
    "prepublishOnly": "npm run verify && npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "~1.3.26",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurentvandelle/boilerlift.git"
  },
  "bugs": {
    "url": "https://github.com/laurentvandelle/boilerlift/issues"
  },
  "homepage": "https://github.com/laurentvandelle/boilerlift#readme",
  "keywords": [
    "n8n",
    "n8n-workflows",
    "workflow-automation",
    "workflow-as-code",
    "typescript",
    "cli",
    "deployment",
    "gitops"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.21.3",
      "onFail": "error"
    }
  }
}
